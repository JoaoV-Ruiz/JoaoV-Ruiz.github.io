      "parameters": {
        "jsCode": "// Resumo do teste: mostra o que seria enviado, sem enviar nada.\nconst itens = $input.all();\n\nreturn [\n  {\n    json: {\n      modo: 'teste',\n      mensagens_simuladas: itens.length,\n      previa: itens.map((i) => ({ para: i.json.telefone, mensagem: i.json.mensagem })),\n    },\n  },\n];"
      },
