    {
      "parameters": {},
      "id": "a70a9f67-84e7-4585-a9df-e325af345bf3",
      "name": "Testar com dados de exemplo",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "// Faturas fictícias, com vencimentos calculados a partir de hoje\n// para o teste sempre cair em todas as regras.\nconst dia = (n) => {\n  const d = new Date();\n  d.setDate(d.getDate() + n);\n  const p = (v) => String(v).padStart(2, '0');\n  return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());\n};\n\nconst faturas = [\n  { id: 'F-001', nome: 'Marina Duarte',  telefone: '(53) 99999-0001', valor: 189.9, vencimento: dia(3),  status: 'aberto' },\n  { id: 'F-002', nome: 'Rafael Antunes', telefone: '53 99999-0002',   valor: 250,   vencimento: dia(0),  status: 'aberto' },\n  { id: 'F-003', nome: 'Luiza Peçanha',  telefone: '5553999990003',   valor: 99.5,  vencimento: dia(-3), status: 'aberto' },\n  { id: 'F-004', nome: 'Caio Brandão',   telefone: '(53) 99999-0004', valor: 320,   vencimento: dia(0),  status: 'pago' },\n  { id: 'F-005', nome: 'Helena Prates',  telefone: '',                valor: 140,   vencimento: dia(3),  status: 'aberto' },\n  { id: 'F-006', nome: 'Otávio Lemos',   telefone: '(53) 99999-0006', valor: 75,    vencimento: dia(10), status: 'aberto' },\n];\n\nreturn faturas.map((f) => ({ json: { ...f, modo_teste: true } }));"
      },
      "id": "16ed1847-c40f-4f8d-ac67-4e51e9bfcf50",
      "name": "Faturas de exemplo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "// Decide quem recebe lembrete hoje e prepara os campos da mensagem.\n// Regra: 3 dias antes, no dia do vencimento e 3 dias depois. Fatura paga é ignorada.\nconst REGRAS = { 3: 'vence_em_breve', 0: 'vence_hoje', '-3': 'atrasada' };\n\nconst hoje = new Date();\nhoje.setHours(0, 0, 0, 0);\n\nconst lerData = (valor) => {\n  const s = String(valor ?? '').trim();\n  const br = s.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n  const iso = s.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n  if (br) return new Date(+br[3], +br[2] - 1, +br[1]);\n  if (iso) return new Date(+iso[1], +iso[2] - 1, +iso[3]);\n  return null;\n};\n\nconst saida = [];\n\nfor (const item of $input.all()) {\n  const f = item.json;\n  if (String(f.status ?? '').trim().toLowerCase() === 'pago') continue;\n\n  const venc = lerData(f.vencimento);\n  if (!venc) continue;\n\n  const dias = Math.round((venc - hoje) / 86400000);\n  const situacao = REGRAS[dias];\n  if (!situacao) continue;\n\n  // Telefone: só dígitos, com DDI 55 quando vier apenas DDD + número\n  let telefone = String(f.telefone ?? '').replace(/\\D/g, '');\n  if (telefone.length === 10 || telefone.length === 11) telefone = '55' + telefone;\n  const telefone_valido = telefone.length === 12 || telefone.length === 13;\n\n  saida.push({\n    json: {\n      id: f.id,\n      nome: f.nome,\n      primeiro_nome: String(f.nome ?? '').trim().split(' ')[0],\n      telefone,\n      telefone_valido,\n      situacao,\n      dias_para_vencer: dias,\n      valor_fmt: Number(f.valor).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }),\n      vencimento_fmt: venc.toLocaleDateString('pt-BR'),\n      modo_teste: Boolean(f.modo_teste),\n    },\n  });\n}\n\nreturn saida;"
      },
      "id": "07f7b67d-1001-4100-ab10-fb00c37b785f",
      "name": "Aplicar regra de cobrança",
