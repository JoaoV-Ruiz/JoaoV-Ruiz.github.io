              "id": "f4673a84-ede1-498d-b29c-7896cb3d18e1",
              "name": "mensagem",
              "value": "={{ $json.situacao === 'vence_em_breve' ? `Olá, ${$json.primeiro_nome}! Passando para lembrar que a sua fatura de ${$json.valor_fmt} vence em ${$json.vencimento_fmt}. Se já pagou, pode desconsiderar esta mensagem.` : $json.situacao === 'vence_hoje' ? `Olá, ${$json.primeiro_nome}! A sua fatura de ${$json.valor_fmt} vence hoje (${$json.vencimento_fmt}). Qualquer dúvida, é só responder por aqui.` : `Olá, ${$json.primeiro_nome}! Não identificamos o pagamento da fatura de ${$json.valor_fmt}, vencida em ${$json.vencimento_fmt}. Se precisar de uma segunda via, é só responder por aqui.` }}",
